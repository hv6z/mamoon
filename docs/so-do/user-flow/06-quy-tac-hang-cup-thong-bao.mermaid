  F1 --> F4["Hạn sử dụng điểm / voucher"]
  F1 --> F5["Hạng Cup"]
  F5 --> T1["Cúp Đồng"] --> T2["Cúp Bạc"] --> T3["Cúp Vàng"] --> T4["Cúp Kim Cương"]
  F5 --> F6["Ngưỡng điểm và chu kỳ xét hạng: chờ chốt"]
  HUB --> G1["Thông báo"]
  G1 --> G2["Điểm buổi học + ảnh tranh mới"]
  G1 --> G3["Lên hạng Cup"]
  G1 --> G4["Điểm / voucher sắp hết hạn"]
  G1 --> G5["Kết quả yêu cầu kiểm tra lại"]
  classDef hub fill:#BFEFE6,stroke:#1E9E8C,stroke-width:2px,color:#1b3a36
  classDef lop fill:#FFF1C2,stroke:#D99A00,color:#4a3500
